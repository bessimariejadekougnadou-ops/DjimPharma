# Sécurité & Réseau
DJANGO_SECRET_KEY=votre-cle-secrete-django-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.78,10.0.2.2,*

# Fuseau Horaire Officiel Togo (Africa/Lome = GMT+0)
TIME_ZONE=Africa/Lome

# Intégration Google Places API
# Clé Google Cloud avec activation de "Places API" et "Geocoding API"
GOOGLE_PLACES_API_KEY=AIzaSy...VOTRE_CLE_GOOGLE_PLACES_API
GOOGLE_PLACES_CACHE_HOURS=24
GOOGLE_PLACES_DEFAULT_RADIUS=5000
GOOGLE_PLACES_RATE_LIMIT_DELAY=0.2

# Notifications Push (Firebase Cloud Messaging)
FCM_SERVER_KEY=AAAA...VOTRE_CLE_SERVEUR_FIREBASE_FCM

